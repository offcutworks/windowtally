{
  "manifest_version": 3,
  "name": "WindowTally",
  "version": "1.0.0",
  "description": "Hands WindowTally the 5-hour and weekly figures, and the week's use by product, that claude.ai's page receives. Sends no request.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["https://claude.ai/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_start"},
    {"matches": ["https://claude.ai/*"], "js": ["relay.js"], "run_at": "document_start"}
  ]
}
